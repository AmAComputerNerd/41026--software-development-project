OPENROUTER_API_KEY=
# Optional; defaults to nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=
# Set false to disable Student 3's optional MCP integration (for example, in CI).
MCP_ENABLED=true
# Set false to disable Student 3's optional RAG integration (for example, in CI).
RAG_ENABLED=true
CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=

# For Release 1, where we stop testing in MailHog and use a proper SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_SSL=true
# SMTP_FROM_ADDRESS=no-reply@your-domain.com
# SMTP_FROM_NAME=Your App Name
