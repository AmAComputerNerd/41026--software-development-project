OPENROUTER_API_KEY=
# Optional; defaults to nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=
MCP_ENABLED=true
MCP_HOST_PORT=5002
RAG_ENABLED=true
RAG_HOST_PORT=5003
# TODO: Extract AI mode to be a separate non-containerised service.
AI_MODE_HOST_PORT=5001
CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=

# For Release 1, where we stop testing in MailHog and use a proper SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_SSL=true
# SMTP_FROM_ADDRESS=no-reply@your-domain.com
# SMTP_FROM_NAME=Your App Name
