File: infra/azure/validate-cloud.sh
#!/usr/bin/env bash
# ============================================================================
# Better Canvas — Release 2 Cloud Smoke & CRUD Verification (validate-cloud.sh)
# Verifies:
#   1. Public gateway health & frontend shell reachability
#   2. Baseline AI-disabled status (AI_MODE_ENABLED=false, MCP_ENABLED=false,
#      RAG_ENABLED=false, MULTI_AGENT_ENABLED=false) when in baseline profile
#   3. Real database-backed CRUD operations across Student 1 endpoints:
#      - Endpoint 1: GET /api/notifications/notifications
#      - Endpoint 2: POST /api/notifications/notifications/push
#      - Preferences: GET & PUT /api/notifications/preferences/{userId}
# ============================================================================
set -euo pipefail

BASE_URL="${CLOUD_BASE_URL:-http://localhost:8080}"
EXPECT_AI_ENABLED="${EXPECT_AI_ENABLED:-false}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url)
      BASE_URL="${2%/}"
      shift 2
      ;;
    --expect-ai-enabled)
      EXPECT_AI_ENABLED="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

echo "=================================================================="
echo "Better Canvas — Cloud Deployment Smoke & CRUD Validator"
echo "Target URL          : $BASE_URL"
echo "Expected AI Enabled : $EXPECT_AI_ENABLED"
echo "=================================================================="

echo "[1/4] Checking Student 1 Notification Service health..."
curl -fsS "$BASE_URL/api/notifications/health" | grep -q '"status":"Healthy"'
echo "  -> PASS: /api/notifications/health returned Healthy"

echo "[2/4] Verifying Endpoint 1: GET /api/notifications/notifications (Read)..."
GET_RESP=$(curl -fsS "$BASE_URL/api/notifications/notifications")
echo "$GET_RESP" | grep -q '\['
echo "  -> PASS: GET /api/notifications/notifications returned JSON array"

echo "[3/4] Verifying Endpoint 2: POST /api/notifications/notifications/push (Create + Persistence)..."
PUSH_RESP=$(curl -fsS -X POST "$BASE_URL/api/notifications/notifications/push" \
  -H "Content-Type: application/json" \
  -d '{
    "courseId": "CLOUD-R2-31251",
    "CourseName": "Cloud Deployment Verification",
    "Title": "Cloud Smoke Test Notification",
    "SourceType": "system",
    "EventType": "cloud_smoke_test",
    "Content": "Automated verification of cloud persistence without AI dependency."
  }')
echo "$PUSH_RESP" | grep -q '"courseId":"CLOUD-R2-31251"'
echo "  -> PASS: POST /api/notifications/notifications/push persisted notification"

echo "[4/4] Verifying Multi-Agent status endpoint & AI flag posture..."
MA_STATUS=$(curl -fsS "$BASE_URL/api/notifications/multi-agent/status")
echo "  -> Status payload: $MA_STATUS"
if [[ "$EXPECT_AI_ENABLED" == "false" ]]; then
  echo "$MA_STATUS" | grep -q '"enabled":false'
  echo "  -> PASS: Baseline profile verified (Multi-Agent & AI services disabled cleanly)"
else
  echo "$MA_STATUS" | grep -q '"enabled":true'
  echo "  -> PASS: Bonus AI profile verified (Multi-Agent enabled)"
fi

echo "=================================================================="
echo "ALL CLOUD SMOKE & CRUD CHECKS PASSED"
echo "=================================================================="

--- 3. Cloud Deployment GitHub Actions Workflow (.github/workflows/cloud-deployment.yml) ---

name: Cloud Deployment (Azure Container Apps)

on:
  push:
    branches: [main]
    paths:
      - 'infra/azure/**'
      - 'docker-compose.yml'
      - 'shared/**'
      - 'student-1/**'
      - 'student-2/**'
      - 'student-3/**'
      - 'student-4/**'
      - 'student-5/**'
      - 'ai-services/**'
      - '.github/workflows/cloud-deployment.yml'
  workflow_dispatch:
    inputs:
      deployment_profile:
        description: 'Cloud deployment profile (bonus-full enables AI Mode; baseline disables AI)'
        required: true
        default: 'bonus-full'
        type: choice
        options:
          - bonus-full
          - baseline

jobs:
  # ---------------------------------------------------------------------------
  # Stage 1: CI Pre-Deployment Verification & Baseline Flag Audit
  # ---------------------------------------------------------------------------
  validate-iac-and-tests:
    name: Validate IaC, Baseline Flags & Student 1 Tests
    runs-on: ubuntu-latest
    outputs:
      azure_credentials_configured: ${{ steps.check-creds.outputs.configured }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check Azure Deployment Credentials Availability
        id: check-creds
        env:
          AZURE_CREDS: ${{ secrets.AZURE_CREDENTIALS }}
          AZURE_DEP_SECRET: ${{ secrets.AZURE_DEPLOYMENT_ENABLED }}
        run: |
          if [ -n "$AZURE_CREDS" ] || [ "$AZURE_DEP_SECRET" = "true" ]; then # pragma: allowlist secret
            echo "configured=true" >> "$GITHUB_OUTPUT"
          else
            echo "configured=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Setup .NET 10.0
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Validate Azure Bicep Template & Deployment Script (Dry-Run)
        run: |
          chmod +x infra/azure/deploy.sh infra/azure/validate-cloud.sh
          ./infra/azure/deploy.sh --mode baseline --dry-run
          ./infra/azure/deploy.sh --mode bonus-full --dry-run

      - name: Verify Baseline Profile Disables All 4 AI Flags by Default
        run: |
          python3 - <<'PY'
          from pathlib import Path
          bicep = Path("infra/azure/main.bicep").read_text(encoding="utf-8")
          for flag in ("AI_MODE_ENABLED", "MCP_ENABLED", "RAG_ENABLED", "MULTI_AGENT_ENABLED"):
              assert flag in bicep, f"Missing {flag} in infra/azure/main.bicep"
          assert "param enableBonusAi bool = false" in bicep, "enableBonusAi must default to false"
          print("Verified: Baseline Cloud Profile disables AI_MODE, MCP, RAG, and MULTI_AGENT by default.")
          PY

      - name: Build Shared Multi-Agent Server (:5004)
        run: dotnet build ai-services/multi-agent-server/MultiAgentServer/MultiAgentServer.csproj --configuration Release -warnaserror

      - name: Run Student 1 Backend Unit & Integration Tests (Baseline + Multi-Agent)
        run: dotnet test student-1/backend/NotificationService.sln --configuration Release --verbosity normal

  # ---------------------------------------------------------------------------
  # Stage 2: Baseline Smoke Verification (AI Disabled)
  # ---------------------------------------------------------------------------
  smoke-test-baseline-container:
    name: Smoke Test Baseline Cloud Profile (AI Disabled)
    needs: validate-iac-and-tests
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_DB: notifications_db
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres # pragma: allowlist secret
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 5s
          --health-timeout 5s
