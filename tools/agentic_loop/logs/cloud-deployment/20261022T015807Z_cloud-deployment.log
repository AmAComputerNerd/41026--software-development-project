  pull_request:
    paths:
      - "ai-services/**"
      - "shared/**"
      - "student-*/**"
      - "docker-compose.yml"
      - "package.json"
      - "package-lock.json"
      - ".env.example"
      - "tools/setup_env.py"
      - "tools/run_ai_services.py"
      - ".github/workflows/docker-ci.yml"

concurrency:
  group: docker-ci-${{ github.ref }}
  cancel-in-progress: true

env:
  OPENROUTER_API_KEY: ci-placeholder
  CANVAS_BASE_URL: https://canvas.example.invalid
  CANVAS_API_TOKEN: ci-placeholder

jobs:
  compose-contract:
    name: Compose contract
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      services: ${{ steps.discover.outputs.services }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Create Compose environment
        run: |
          cat << 'EOF' > .env
          OPENROUTER_API_KEY="ci-placeholder" # pragma: allowlist secret
          OPENROUTER_MODEL=ci-placeholder
          CANVAS_BASE_URL=https://canvas.example.invalid
          CANVAS_API_TOKEN="ci-placeholder"
          MCP_ENABLED=false
          RAG_ENABLED=false
          AI_MODE_ENABLED=false
          AI_MODE_HOST_PORT=5001
          MCP_HOST_PORT=5002
          RAG_HOST_PORT=5003
          MULTI_AGENT_ENABLED=false
          MULTI_AGENT_HOST_PORT=5004
          EOF
          python -c 'import secrets; print("POSTGRES_PASSWORD=" + secrets.token_hex(32))' >> .env

      - name: Validate Compose configuration
        run: docker compose config --quiet

      - name: Verify AI service boundaries
        shell: bash
        run: |
          set -euo pipefail

          config=$(docker compose config --format json)
          jq --exit-status '
            . as $config |
            (["ai-mode", "mcp-server", "rag-server", "multi-agent-server"] | all(
              . as $service | $config.services | has($service) | not
            )) and
            ([.services | to_entries[] |
              select(.value.environment | has("OPENROUTER_API_KEY")) | .key] == []) and
            (.networks | has("ai-services") | not) and
            ([1, 2, 3, 4, 5] | all(
              . as $student |
              $config.services["student-\($student)-backend"] as $backend |
              ($backend.environment.AiGateway__BaseUrl == "http://host.docker.internal:5001") and
              ($backend.environment.McpServer__BaseUrl == "http://host.docker.internal:5002/mcp") and
              ($backend.environment.RagServer__BaseUrl == "http://host.docker.internal:5003") and
              ($backend.extra_hosts == ["host.docker.internal=host-gateway"])
            )) and
            (.services["student-1-backend"].environment.MultiAgentServer__Enabled == "false") and
            (.services["student-1-backend"].environment.MultiAgentServer__BaseUrl |
              startswith("http://host.docker.internal:")) and
