name: Student 1 - CI

on:
  push:
    branches: [main]
    paths:
      - "student-1/backend/**"
      - "student-1/database/**"
      - "student-1/frontend/**"
      - "shared/ui-kit/**"
      - "package.json"
      - "package-lock.json"
      - ".github/workflows/student-1.yml"
  pull_request:
    paths:
      - "student-1/backend/**"
      - "student-1/database/**"
      - "student-1/frontend/**"
      - "shared/ui-kit/**"
      - "package.json"
      - "package-lock.json"
      - ".github/workflows/student-1.yml"

# Cancel superseded runs on the same branch/PR to save CI minutes.
concurrency:
  group: student-1-ci-${{ github.ref }}
  cancel-in-progress: true

env:
  DOTNET_VERSION: "10.0.x"
  NODE_VERSION: "22"
  DOTNET_NOLOGO: true
  DOTNET_CLI_TELEMETRY_OPTOUT: true
  DOTNET_SOLUTION: student-1/backend/NotificationService.sln
  WORKING_DIR: student-1/backend/Api

jobs:
  frontend-tests:
    name: Frontend build & Playwright E2E tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Type check and build
        run: npm run build --workspace=student-1-frontend

      - name: Run Playwright E2E tests
        run: npm run test:e2e --workspace=student-1-frontend

  build-and-test:
    name: Backend build, test & format check
    runs-on: ubuntu-latest
    env:
      McpServer__Enabled: "false"
      RagServer__Enabled: "false"
      MultiAgentServer__Enabled: "false"
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: ${{ env.DOTNET_VERSION }}

      - name: Cache NuGet packages
        uses: actions/cache@v4
        with:
          path: ~/.nuget/packages
          key: ${{ runner.os }}-nuget-${{ hashFiles('student-1/backend/**/*.csproj') }}
          restore-keys: |
            ${{ runner.os }}-nuget-

      - name: Restore
        run: dotnet restore "${{ env.DOTNET_SOLUTION }}"

      - name: Build (Release, warnings as errors)
        run: dotnet build "${{ env.DOTNET_SOLUTION }}" --configuration Release --no-restore -warnaserror

      - name: Post-Commit CI/CD Endpoint Tests (Endpoint 1 GET /notifications & Endpoint 2 POST /notifications/push)
        run: dotnet test "${{ env.DOTNET_SOLUTION }}" --configuration Release --no-build --filter "FullyQualifiedName~NotificationEndpointsTests|FullyQualifiedName~MultiAgentIntegrationEndpointsTests" --logger "console;verbosity=normal"

