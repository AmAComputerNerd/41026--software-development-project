# -------------------------------------------------------------
# Agentic Loop Configuration
# -------------------------------------------------------------

# Primary: OpenRouter Configuration (Approved by Tutor)
# Can also inherit automatically from root .env
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Fallback / Local: Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REVIEW_MODEL=deepseek-r1:8b

# Optional: Port overrides for standalone development outside Docker
API_BASE_URL_STUDENT_1=http://localhost:5101
API_BASE_URL_STUDENT_3=http://localhost:5103
API_BASE_URL_STUDENT_5=http://localhost:5105
FRONTEND_BASE_URL_STUDENT_1=http://localhost:5173
FRONTEND_BASE_URL_STUDENT_3=http://localhost:5173
